# Copy to .env and fill in real values. Never commit .env.
# Real environment variables (systemd, Docker, Codespaces secrets) override this file.

# --- Required ---
GROQ_API_KEY=your-groq-api-key-here

# --- Optional (defaults shown) ---
# development | testing | production. In production, auth cookies are marked Secure
# (needs HTTPS, e.g. the Cloudflare Tunnel).
KYVON_ENV=development
PORT=8080
KYVON_HOST=0.0.0.0
LOG_LEVEL=INFO

# Where the database, error log and legacy memory file live (relative to the working directory).
KYVON_DATA_DIR=data
# Defaults to sqlite:///<KYVON_DATA_DIR>/kyvon.db
# DATABASE_URL=sqlite:///data/kyvon.db

KYVON_MODEL=openai/gpt-oss-120b
KYVON_WEB_MODEL=groq/compound

# How long a signed-in device stays signed in.
KYVON_TOKEN_TTL_DAYS=30
# Overrides the KYVON_ENV-based default for the Secure cookie flag.
# KYVON_COOKIE_SECURE=true

# --- Google Calendar (optional) ---
# Create an OAuth client (type: Web application) in Google Cloud Console, enable the Google
# Calendar API, and add this redirect URI:  <KYVON_PUBLIC_URL>/api/v1/calendar/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Where browsers reach KYVON (used to build the OAuth redirect URI).
# KYVON_PUBLIC_URL=https://kyvon.example.com
# Encrypts stored OAuth tokens. Generate with: flask --app wsgi kyvon generate-key
# KYVON_ENCRYPTION_KEY=

# --- Hermes (optional agent backend) ---
# An OpenAI-compatible endpoint serving a Hermes model. KYVON stays the assistant; Hermes only
# runs as the "hermes" agent, and every tool it asks for still goes through KYVON's checks.
# Point this at a model endpoint, never at anything with shell or file access to your server.
# KYVON_HERMES_URL=http://localhost:8000/v1
# KYVON_HERMES_API_KEY=
# KYVON_HERMES_MODEL=hermes
# Only private/loopback addresses are accepted unless this is true.
# KYVON_HERMES_ALLOW_REMOTE=false

# --- Logseq (optional second brain) ---
# Folder of a Logseq graph (contains pages/ and journals/). KYVON reads it freely and only
# writes with your approval; it never deletes pages and never leaves pages/ and journals/.
# KYVON_LOGSEQ_DIR=/home/you/logseq-graph

# --- Automation ---
# The scheduler runs inside the web process (use one gunicorn worker). Set to false to disable.
# KYVON_SCHEDULER=true
# KYVON_SCHEDULER_TICK_SECONDS=30

# --- Web Push (optional; reminders always appear in the in-app Inbox) ---
# Generate with: flask --app wsgi kyvon generate-vapid-keys
# KYVON_VAPID_PUBLIC_KEY=
# KYVON_VAPID_PRIVATE_KEY=
# KYVON_VAPID_SUBJECT=mailto:you@example.com

# --- Tuning and limits (defaults are sensible; see docs/CONFIGURATION.md for all of them) ---
# KYVON_LOG_JSON=true
# KYVON_TRUSTED_ORIGINS=
# KYVON_RATE_LIMIT_CHAT=30
# KYVON_RATE_LIMIT_API=300
# KYVON_MAX_REQUEST_BYTES=1000000
# KYVON_MAX_AUDIO_BYTES=10000000
# KYVON_STT_MODEL=whisper-large-v3-turbo
# KYVON_CONTEXT_MAX_TOKENS=6000
# KYVON_MEMORY_MAX=2000
