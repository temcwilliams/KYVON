# Settings for a HOSTED KYVON (KYVON_MODE=hosted). Copy to .env.hosted and fill in. NEVER commit real values.
# Every setting is documented in docs/CONFIGURATION.md.

POSTGRES_PASSWORD=change-me
GROQ_API_KEY=your-groq-api-key-here

# Where people reach it (https, no trailing slash). Used in emailed links.
KYVON_PUBLIC_URL=https://app.example.com
KYVON_COOKIE_SECURE=true
KYVON_PROXY_HOPS=1

# Keep sign-up closed until email, billing and the legal pages are ready.
KYVON_SIGNUP_OPEN=false
KYVON_TERMS_VERSION=1

# Outgoing email (verification and password reset). Use a real provider with SPF/DKIM set up.
KYVON_EMAIL_FROM=KYVON <no-reply@example.com>
KYVON_SMTP_HOST=smtp.example.com
KYVON_SMTP_PORT=587
KYVON_SMTP_USER=
KYVON_SMTP_PASSWORD=

# Stripe (start with TEST keys). The webhook endpoint is <public url>/api/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
KYVON_PRICE_LABEL=$9 / month

# Monthly allowances. These control your AI bill: set them from real prices and your plan price.
KYVON_QUOTA_FREE_MESSAGES=30
KYVON_QUOTA_FREE_TOKENS=60000
KYVON_QUOTA_PRO_MESSAGES=3000
KYVON_QUOTA_PRO_TOKENS=6000000
