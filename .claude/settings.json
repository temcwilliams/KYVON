{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/ruff format --check:*)",
      "Bash(.venv/bin/bandit:*)",
      "Bash(.venv/bin/alembic heads:*)",
      "Bash(.venv/bin/alembic history:*)",
      "Bash(.venv/bin/alembic current:*)",
      "Bash(.venv/bin/python scripts/gen_config_docs.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.hosted)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_edit.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.py\"" }]
      }
    ]
  }
}
